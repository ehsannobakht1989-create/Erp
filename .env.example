# Copy to .env (the web installer at /install writes it for you on cPanel).
APP_NAME=ERP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
ERP_DISPLAY_TIMEZONE=Asia/Tehran

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp
DB_USERNAME=root
DB_PASSWORD=

# Shared-hosting defaults: no Redis or daemons; cron runs `php artisan schedule:run` every minute.
QUEUE_CONNECTION=database
SESSION_DRIVER=file
CACHE_STORE=file
SANCTUM_STATEFUL_DOMAINS=localhost

# AI stays off unless enabled here AND per company module and capability.
ERP_AI_ENABLED=false
AI_KILL_SWITCH=false
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_MODEL=gpt-4o-mini
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_SECRET=
