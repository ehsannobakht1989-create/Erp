{
    "name": "erp/manufacturing",
    "require": {
        "php": "^8.2",
        "brick/math": "^0.14",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3"
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "description": "Modular manufacturing ERP platform",
    "type": "project",
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "laravel/pint": "^1.30"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    }
}
