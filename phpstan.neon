parameters:
    # PHPDoc describes expected shapes; runtime guards still validate untrusted provider data.
    treatPhpDocTypesAsCertain: false
    level: 5
    paths:
        - app
        - tools/depth
        - tools/architecture
        - tests/platform
        - tests/Platform
        - tests/run-platform.php
        - builder
        - modules
        - public/index.php
    tmpDir: .cache/phpstan
